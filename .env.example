# ==============================================================================
# HireTrace Environment Configuration
# Copy this file to .env before starting Docker Compose or production services:
#   cp .env.example .env
# ==============================================================================

# Security & Authentication (REQUIRED in production - no default fallback)
# HIRETRACE_API_KEY: REQUIRED - must be set before running `docker compose -f docker-compose.prod.yml up`.
# Generate with `openssl rand -hex 32` (minimum 24 characters required).
HIRETRACE_REQUIRE_AUTH=1
HIRETRACE_API_KEY=generate_and_insert_secure_32_char_hex_key_here

# Optional Multi-Tenant API Keys mapping (JSON format):
# HIRETRACE_API_KEYS={"key1_at_least_24_chars_long": "tenant_a", "key2_at_least_24_chars_long": "tenant_b"}

# Database Configuration (PostgreSQL in Docker / Production)
# POSTGRES_PASSWORD: REQUIRED — no default, must be set before `docker compose -f docker-compose.prod.yml up`
POSTGRES_USER=hiretrace
POSTGRES_PASSWORD=replace_with_a_secure_production_password
POSTGRES_DB=hiretrace
DATABASE_URL=postgresql://hiretrace:replace_with_a_secure_production_password@postgres:5432/hiretrace

# Local LLM Backend (Zero paid APIs, 100% self-hosted)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=90.0

# Concurrency & Work Queues
# CONCURRENCY_WORKERS: Number of concurrent applicant evaluation jobs in the queue
CONCURRENCY_WORKERS=4

# MAX_LLM_CONCURRENCY: Bounded semaphore ceiling for simultaneous GPU model calls
# Set to 1 for consumer GPUs (<8GB VRAM), 2 for 8-16GB VRAM, or higher for vLLM clusters
MAX_LLM_CONCURRENCY=1

# Server Bindings
HOST=0.0.0.0
PORT=8000
