# HireTrace Configuration
# ZERO PAID API KEYS NEEDED - 100% LOCAL INFERENCE VIA OLLAMA

# Ollama Endpoint (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Selected Local Model (qwen2.5:3b or qwen2.5:1.5b)
OLLAMA_MODEL=qwen2.5:3b

# Retrieval & Evaluation
EMBEDDING_DEVICE=cpu
FAISS_TOP_K=4
LOG_LEVEL=INFO
